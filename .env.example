# Copy to .env for local development of the /admin publisher (not needed for the site itself).
# In production these are set in Vercel → Project → Settings → Environment Variables.
ADMIN_PASSWORD=change-me
GITHUB_TOKEN=github_pat_xxx
GITHUB_REPO=msulacrosse/msu-lacrosse-site
GITHUB_BRANCH=main
