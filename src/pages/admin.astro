---
import Base from '../layouts/Base.astro';
const today = new Date().toISOString().slice(0, 10);
const tags = ['Recap', 'Team', 'Community', 'Alumni', 'Recruiting', 'Announcement'];
---
<Base title="Post an update" noindex>
  <div class="container page">
    <div class="eyebrow">Team only</div>
    <h1 class="h-page" style="font-size:clamp(36px,5vw,64px)">Post an update</h1>
    <p class="muted intro">Write a news post for the site. It goes live a minute or two after you hit publish. This page isn't linked anywhere, so only share the address with people who should be posting.</p>

    <form id="post-form" class="form" novalidate>
      <div class="grid">
        <label class="field span2">
          <span>Title</span>
          <input name="title" required maxlength="120" placeholder="Spartans open the season with a win" />
        </label>
        <label class="field">
          <span>Date</span>
          <input name="date" type="date" value={today} required />
        </label>
        <label class="field">
          <span>Category</span>
          <select name="tag">{tags.map((t) => <option>{t}</option>)}</select>
        </label>
        <label class="field span2">
          <span>Short summary <em>(shows on the news cards)</em></span>
          <input name="excerpt" maxlength="300" placeholder="One or two sentences." />
        </label>
        <label class="field">
          <span>Your name <em>(optional)</em></span>
          <input name="author" maxlength="80" placeholder="Coach Konas" />
        </label>
        <label class="field">
          <span>Photo <em>(optional)</em></span>
          <input name="image" type="file" accept="image/*" />
        </label>
        <div class="field span2">
          <div class="editor-head">
            <span>Article</span>
            <div class="tabs" role="tablist">
              <button type="button" class="tab is-active" data-tab="write">Write</button>
              <button type="button" class="tab" data-tab="preview">Preview</button>
            </div>
          </div>
          <textarea name="body" rows="16" required placeholder="Write here. Blank line between paragraphs. **bold**, *italic*, ## Heading, - list item, [link text](https://...)"></textarea>
          <div class="preview prose" id="preview" hidden></div>
          <p class="hint">Plain text works fine. Formatting is optional: <code>**bold**</code>, <code>*italic*</code>, <code>## Heading</code>, <code>- bullet</code>, <code>[link](https://…)</code>.</p>
        </div>
        <label class="field">
          <span>Password</span>
          <input name="password" type="password" required autocomplete="current-password" />
        </label>
      </div>
      <div class="actions">
        <button type="submit" class="btn" id="submit">Publish <span class="arrow">→</span></button>
        <span id="status" class="status" role="status" aria-live="polite"></span>
      </div>
    </form>
  </div>
</Base>

<style>
  .page { padding-top: 160px; max-width: 900px; min-height: 100vh; }
  .intro { text-align: center; margin: 20px auto 0; max-width: 620px; font-size: 16px; }
  .form { margin-top: 48px; }
  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  .span2 { grid-column: span 2; }
  @media (max-width: 640px) { .grid { grid-template-columns: 1fr; } .span2 { grid-column: span 1; } }
  .field { display: flex; flex-direction: column; gap: 8px; }
  .field > span, .editor-head > span { font-size: 13px; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; color: var(--dim); }
  .field em { text-transform: none; letter-spacing: 0; font-style: normal; color: #666; }
  input, select, textarea {
    width: 100%; padding: 14px 16px; border-radius: 12px; border: 1px solid var(--border); background: var(--card); color: #fff;
    font: inherit; font-size: 16px; outline: none; transition: border-color 0.2s;
  }
  input:focus, select:focus, textarea:focus { border-color: var(--mint); }
  input[type="file"] { padding: 11px 16px; }
  input[type="file"]::file-selector-button { font: inherit; font-size: 14px; font-weight: 600; padding: 6px 14px; border-radius: 999px; border: 0; background: var(--green); color: #fff; margin-right: 12px; cursor: pointer; }
  select { appearance: none; background-image: linear-gradient(45deg, transparent 50%, #8a8a8a 50%), linear-gradient(135deg, #8a8a8a 50%, transparent 50%); background-position: calc(100% - 22px) 50%, calc(100% - 16px) 50%; background-size: 6px 6px; background-repeat: no-repeat; }
  textarea { resize: vertical; min-height: 320px; line-height: 1.6; }
  .editor-head { display: flex; justify-content: space-between; align-items: center; }
  .tabs { display: flex; gap: 4px; background: var(--card); border: 1px solid var(--border); border-radius: 999px; padding: 3px; }
  .tab { border: 0; background: transparent; color: var(--muted); padding: 6px 14px; border-radius: 999px; font-size: 13px; font-weight: 600; cursor: pointer; }
  .tab.is-active { background: var(--green); color: #fff; }
  .preview { min-height: 320px; padding: 24px 28px; border-radius: 12px; border: 1px solid var(--border); background: var(--card); font-size: 17px; max-width: none; }
  .preview[hidden] { display: none; }
  .hint { font-size: 13px; color: var(--dim); }
  .hint code { font-size: 12px; background: #161616; padding: 2px 6px; border-radius: 6px; }
  .actions { display: flex; align-items: center; gap: 20px; margin-top: 32px; flex-wrap: wrap; }
  .status { font-size: 15px; font-weight: 600; color: var(--muted); }
  .status.ok { color: var(--mint); }
  .status.err { color: #f08a8a; }
  .status a { text-decoration: underline; }
  .btn[disabled] { opacity: 0.6; cursor: wait; transform: none; }
</style>

<script>
  import { marked } from 'marked';

  const form = document.getElementById('post-form') as HTMLFormElement;
  const status = document.getElementById('status')!;
  const submit = document.getElementById('submit') as HTMLButtonElement;
  const textarea = form.elements.namedItem('body') as HTMLTextAreaElement;
  const preview = document.getElementById('preview')!;

  // Write / Preview tabs
  document.querySelectorAll<HTMLButtonElement>('.tab').forEach((tab) => tab.addEventListener('click', () => {
    document.querySelectorAll('.tab').forEach((t) => t.classList.toggle('is-active', t === tab));
    const showPreview = tab.dataset.tab === 'preview';
    if (showPreview) preview.innerHTML = marked.parse(textarea.value || '*Nothing written yet.*') as string;
    preview.hidden = !showPreview;
    textarea.hidden = showPreview;
  }));

  // Shrink photos in the browser so uploads stay small
  async function prepareImage(file: File): Promise<{ name: string; type: string; data: string } | undefined> {
    if (!file || !file.size) return undefined;
    const bitmap = await createImageBitmap(file).catch(() => null);
    if (!bitmap) {
      const buf = await file.arrayBuffer();
      return { name: file.name, type: file.type, data: btoa(String.fromCharCode(...new Uint8Array(buf))) };
    }
    const max = 1800;
    const scale = Math.min(1, max / Math.max(bitmap.width, bitmap.height));
    const canvas = document.createElement('canvas');
    canvas.width = Math.round(bitmap.width * scale);
    canvas.height = Math.round(bitmap.height * scale);
    canvas.getContext('2d')!.drawImage(bitmap, 0, 0, canvas.width, canvas.height);
    const type = file.type === 'image/png' ? 'image/png' : 'image/jpeg';
    const dataUrl = canvas.toDataURL(type, 0.85);
    return { name: file.name, type, data: dataUrl.split(',')[1] };
  }

  const setStatus = (msg: string, cls = '') => { status.className = `status ${cls}`; status.innerHTML = msg; };

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const fd = new FormData(form);
    if (!fd.get('title') || !fd.get('body') || !fd.get('password')) { setStatus('Title, article and password are required.', 'err'); return; }
    submit.disabled = true;
    setStatus('Preparing…');
    try {
      const image = await prepareImage(fd.get('image') as File);
      setStatus('Publishing…');
      const res = await fetch('/api/publish', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          password: fd.get('password'), title: fd.get('title'), date: fd.get('date'), tag: fd.get('tag'),
          excerpt: fd.get('excerpt'), author: fd.get('author'), body: fd.get('body'), image,
        }),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.error || `Error ${res.status}`);
      setStatus(`Published. It will appear at <a href="${data.url}">${location.origin}${data.url}</a> in a minute or two once the site rebuilds.`, 'ok');
      form.reset();
      (form.elements.namedItem('date') as HTMLInputElement).value = new Date().toISOString().slice(0, 10);
    } catch (err: any) {
      setStatus(err.message || 'Something went wrong.', 'err');
    } finally {
      submit.disabled = false;
    }
  });
</script>
