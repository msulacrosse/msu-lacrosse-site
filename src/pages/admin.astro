---
import Base from '../layouts/Base.astro';
const tags = ['Recap', 'Team', 'Community', 'Alumni', 'Recruiting', 'Announcement'];
---
<Base title="Team admin" noindex>
  <div class="container page">

    <!-- Sign in -->
    <section id="view-login" class="view">
      <div class="eyebrow">Team only</div>
      <h1 class="h-page" style="font-size:clamp(36px,5vw,64px)">Sign in</h1>
      <form id="login-form" class="login" novalidate>
        <label class="field"><span>Password</span><input name="password" type="password" required autocomplete="current-password" autofocus /></label>
        <div class="actions">
          <button type="submit" class="btn" id="login-btn">Sign in <span class="arrow">→</span></button>
          <span class="status" id="login-status" role="status"></span>
        </div>
      </form>
    </section>

    <!-- Post list -->
    <section id="view-list" class="view" hidden>
      <div class="topbar">
        <div>
          <div class="eyebrow" style="justify-content:flex-start">News</div>
          <h1 class="h-page" style="text-align:left;margin-top:16px;font-size:clamp(36px,5vw,64px)">Posts</h1>
        </div>
        <div class="topbar__actions">
          <button class="btn" id="new-post">New post <span class="arrow">+</span></button>
          <button class="ghost" id="sign-out" type="button">Sign out</button>
        </div>
      </div>
      <p class="status" id="list-status" role="status"></p>
      <div class="post-list" id="post-list"></div>
    </section>

    <!-- Editor -->
    <section id="view-editor" class="view" hidden>
      <button class="ghost back" id="back-to-list" type="button">← All posts</button>
      <h1 class="h-page" id="editor-heading" style="text-align:left;margin-top:16px;font-size:clamp(36px,5vw,64px)">New post</h1>
      <form id="post-form" class="form" novalidate>
        <div class="grid">
          <label class="field span2"><span>Title</span><input name="title" required maxlength="120" placeholder="Spartans open the season with a win" /></label>
          <label class="field"><span>Date</span><input name="date" type="date" required /></label>
          <label class="field"><span>Category</span><select name="tag">{tags.map((t) => <option>{t}</option>)}</select></label>
          <label class="field span2"><span>Short summary <em>(shows on the news cards)</em></span><input name="excerpt" maxlength="300" placeholder="One or two sentences." /></label>
          <label class="field"><span>Your name <em>(optional)</em></span><input name="author" maxlength="80" placeholder="Coach Konas" /></label>
          <div class="field">
            <span>Photo <em>(optional)</em></span>
            <input name="image" type="file" accept="image/*" />
            <div class="current-image" id="current-image" hidden>
              <img id="current-image-img" alt="" />
              <label class="check"><input type="checkbox" name="removeImage" /> Remove this photo</label>
            </div>
          </div>
          <div class="field span2">
            <span>Article</span>
            <div class="editor-shell"><div id="editor"></div></div>
            <p class="hint">Use the toolbar for headings, bold, lists and links. Paste from anywhere; formatting is kept.</p>
          </div>
        </div>
        <div class="actions">
          <button type="submit" class="btn" id="save-btn">Publish <span class="arrow">→</span></button>
          <button type="button" class="ghost danger" id="delete-btn" hidden>Delete post</button>
          <span class="status" id="save-status" role="status" aria-live="polite"></span>
        </div>
      </form>
    </section>
  </div>
</Base>

<style is:global>
  /* Quill (rich text editor) restyled for the dark theme */
  .ql-toolbar.ql-snow { border: 1px solid var(--border); border-bottom: 0; border-radius: 12px 12px 0 0; background: #121212; padding: 10px 12px; }
  .ql-container.ql-snow { border: 1px solid var(--border); border-radius: 0 0 12px 12px; background: var(--card); font-family: var(--font); font-size: 17px; min-height: 360px; }
  .ql-editor { min-height: 360px; line-height: 1.7; color: #e6e6e6; padding: 20px 24px; }
  .ql-editor.ql-blank::before { color: #666; font-style: normal; left: 24px; }
  .ql-editor h2 { font-size: 28px; margin: 1.2em 0 0.5em; letter-spacing: -0.02em; }
  .ql-editor h3 { font-size: 22px; margin: 1.1em 0 0.4em; letter-spacing: -0.02em; }
  .ql-editor p { margin: 0 0 1em; }
  .ql-editor a { color: var(--mint); }
  .ql-editor blockquote { border-left: 3px solid var(--green); color: var(--muted); padding-left: 16px; margin: 1em 0; }
  .ql-snow .ql-stroke { stroke: #cfcfcf; }
  .ql-snow .ql-fill { fill: #cfcfcf; }
  .ql-snow .ql-picker { color: #cfcfcf; }
  .ql-snow .ql-picker-options { background: #161616; border-color: var(--border) !important; }
  .ql-snow .ql-picker-item:hover, .ql-snow .ql-picker-label:hover, .ql-snow .ql-toolbar button:hover .ql-stroke, .ql-snow .ql-toolbar button.ql-active .ql-stroke { stroke: var(--mint); color: var(--mint); }
  .ql-snow .ql-toolbar button:hover .ql-fill, .ql-snow .ql-toolbar button.ql-active .ql-fill { fill: var(--mint); }
  .ql-snow .ql-tooltip { background: #161616; border-color: var(--border); color: #fff; box-shadow: 0 10px 30px rgba(0,0,0,.5); }
  .ql-snow .ql-tooltip input[type=text] { background: var(--card); border-color: var(--border); color: #fff; }
  .ql-snow .ql-tooltip a { color: var(--mint); }
</style>

<style>
  .page { padding-top: 160px; max-width: 960px; min-height: 100vh; }
  .view[hidden] { display: none; }
  .login { max-width: 420px; margin: 40px auto 0; }
  .topbar { display: flex; justify-content: space-between; align-items: flex-end; gap: 20px; flex-wrap: wrap; }
  .topbar__actions { display: flex; gap: 12px; align-items: center; }
  .ghost { background: transparent; border: 1px solid var(--border); color: var(--muted); padding: 10px 18px; border-radius: 999px; font-size: 14px; font-weight: 600; cursor: pointer; }
  .ghost:hover { border-color: var(--border-hover); color: #fff; }
  .ghost.danger:hover { border-color: #b33; color: #f08a8a; }
  .back { padding: 8px 14px; }
  .post-list { display: flex; flex-direction: column; gap: 12px; margin-top: 32px; }
  .post-row { display: grid; grid-template-columns: 1fr auto; gap: 16px; align-items: center; padding: 18px 22px; background: var(--card); border: 1px solid var(--border); border-radius: 16px; transition: border-color 0.2s; }
  .post-row:hover { border-color: var(--border-hover); }
  .post-row .t { font-size: 18px; font-weight: 600; letter-spacing: -0.01em; }
  .post-row .m { font-size: 13px; color: var(--dim); margin-top: 4px; font-weight: 600; }
  .post-row .m b { color: var(--mint); font-weight: 600; }
  .post-row .btns { display: flex; gap: 8px; }
  .post-row .btns .ghost { padding: 8px 14px; font-size: 13px; }
  .empty { color: var(--muted); padding: 40px 0; text-align: center; }
  .form { margin-top: 36px; }
  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  .span2 { grid-column: span 2; }
  @media (max-width: 640px) { .grid { grid-template-columns: 1fr; } .span2 { grid-column: span 1; } }
  .field { display: flex; flex-direction: column; gap: 8px; }
  .field > span { font-size: 13px; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; color: var(--dim); }
  .field em { text-transform: none; letter-spacing: 0; font-style: normal; color: #666; }
  input, select, textarea { width: 100%; padding: 14px 16px; border-radius: 12px; border: 1px solid var(--border); background: var(--card); color: #fff; font: inherit; font-size: 16px; outline: none; transition: border-color 0.2s; }
  input:focus, select:focus { border-color: var(--mint); }
  input[type="file"] { padding: 11px 16px; }
  input[type="file"]::file-selector-button { font: inherit; font-size: 14px; font-weight: 600; padding: 6px 14px; border-radius: 999px; border: 0; background: var(--green); color: #fff; margin-right: 12px; cursor: pointer; }
  select { appearance: none; background-image: linear-gradient(45deg, transparent 50%, #8a8a8a 50%), linear-gradient(135deg, #8a8a8a 50%, transparent 50%); background-position: calc(100% - 22px) 50%, calc(100% - 16px) 50%; background-size: 6px 6px; background-repeat: no-repeat; }
  .current-image { display: flex; align-items: center; gap: 14px; margin-top: 4px; }
  .current-image img { width: 72px; height: 54px; object-fit: cover; border-radius: 8px; border: 1px solid var(--border); }
  .check { display: flex; align-items: center; gap: 8px; font-size: 14px; color: var(--muted); }
  .check input { width: auto; }
  .editor-shell { border-radius: 12px; }
  .hint { font-size: 13px; color: var(--dim); }
  .actions { display: flex; align-items: center; gap: 16px; margin-top: 32px; flex-wrap: wrap; }
  .status { font-size: 15px; font-weight: 600; color: var(--muted); }
  .status.ok { color: var(--mint); }
  .status.err { color: #f08a8a; }
  .status :global(a) { text-decoration: underline; }
  .btn[disabled] { opacity: 0.6; cursor: wait; transform: none; }
</style>

<script>
  import Quill from 'quill';
  import 'quill/dist/quill.snow.css';
  import { marked } from 'marked';

  const $ = (id: string) => document.getElementById(id)!;
  const views = { login: $('view-login'), list: $('view-list'), editor: $('view-editor') };
  const show = (name: keyof typeof views) => { Object.values(views).forEach((v) => (v.hidden = true)); views[name].hidden = false; window.scrollTo({ top: 0 }); };
  const setStatus = (el: HTMLElement, msg: string, cls = '') => { el.className = `status ${cls}`; el.innerHTML = msg; };

  // ---- session
  let token = '';
  try { token = sessionStorage.getItem('msulax-admin') || ''; } catch {}
  const api = async (path: string, init: RequestInit = {}) => {
    const res = await fetch(path, { ...init, headers: { 'content-type': 'application/json', authorization: `Bearer ${token}`, ...(init.headers || {}) } });
    const data = await res.json().catch(() => ({}));
    if (res.status === 401 && path !== '/api/auth') { signOut(); throw new Error('Session expired — sign in again'); }
    if (!res.ok) throw new Error(data.error || `Error ${res.status}`);
    return data;
  };
  const signOut = () => { token = ''; try { sessionStorage.removeItem('msulax-admin'); } catch {} show('login'); };

  $('login-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const fd = new FormData(e.target as HTMLFormElement);
    const btn = $('login-btn') as HTMLButtonElement; btn.disabled = true;
    setStatus($('login-status'), 'Checking…');
    try {
      const data = await api('/api/auth', { method: 'POST', body: JSON.stringify({ password: fd.get('password') }) });
      token = data.token; try { sessionStorage.setItem('msulax-admin', token); } catch {}
      (e.target as HTMLFormElement).reset();
      setStatus($('login-status'), '');
      await loadList();
    } catch (err: any) { setStatus($('login-status'), err.message, 'err'); }
    finally { btn.disabled = false; }
  });
  $('sign-out').addEventListener('click', signOut);

  // ---- list
  async function loadList() {
    show('list');
    setStatus($('list-status'), 'Loading posts…');
    $('post-list').innerHTML = '';
    try {
      const { posts } = await api('/api/posts');
      setStatus($('list-status'), posts.length ? `${posts.length} post${posts.length === 1 ? '' : 's'}` : '');
      if (!posts.length) $('post-list').innerHTML = '<p class="empty">No posts yet. Write the first one.</p>';
      for (const p of posts) {
        const row = document.createElement('div');
        row.className = 'post-row';
        row.innerHTML = `<div><div class="t"></div><div class="m"><b></b> · <span></span></div></div>
          <div class="btns"><button class="ghost edit" type="button">Edit</button><a class="ghost" target="_blank" rel="noopener">View</a></div>`;
        row.querySelector('.t')!.textContent = p.title;
        row.querySelector('.m b')!.textContent = p.tag;
        row.querySelector('.m span')!.textContent = p.date;
        (row.querySelector('a') as HTMLAnchorElement).href = `/news/${p.slug}`;
        row.querySelector('.edit')!.addEventListener('click', () => openEditor(p.slug));
        $('post-list').appendChild(row);
      }
    } catch (err: any) { setStatus($('list-status'), err.message, 'err'); }
  }

  // ---- editor
  const quill = new Quill('#editor', {
    theme: 'snow',
    placeholder: 'Write the article here…',
    modules: { toolbar: [[{ header: [2, 3, false] }], ['bold', 'italic', 'underline'], [{ list: 'ordered' }, { list: 'bullet' }], ['blockquote', 'link'], ['clean']] },
  });
  const form = $('post-form') as HTMLFormElement;
  let editingSlug: string | null = null;
  let existingImage = '';

  function resetEditor() {
    form.reset();
    (form.elements.namedItem('date') as HTMLInputElement).value = new Date().toISOString().slice(0, 10);
    quill.setContents([]);
    existingImage = '';
    $('current-image').hidden = true;
    setStatus($('save-status'), '');
  }

  async function openEditor(slug: string | null) {
    resetEditor();
    editingSlug = slug;
    $('editor-heading').textContent = slug ? 'Edit post' : 'New post';
    $('delete-btn').hidden = !slug;
    ($('save-btn') as HTMLButtonElement).innerHTML = slug ? 'Save changes <span class="arrow">→</span>' : 'Publish <span class="arrow">→</span>';
    show('editor');
    if (!slug) return;
    setStatus($('save-status'), 'Loading…');
    try {
      const p = await api(`/api/posts?slug=${encodeURIComponent(slug)}`);
      const set = (n: string, v: string) => ((form.elements.namedItem(n) as HTMLInputElement).value = v || '');
      set('title', p.title); set('date', p.date); set('tag', p.tag || 'Team'); set('excerpt', p.excerpt); set('author', p.author);
      existingImage = p.image || '';
      if (existingImage) { ($('current-image-img') as HTMLImageElement).src = existingImage; $('current-image').hidden = false; }
      // Older posts were written in Markdown; convert those so the editor can show them
      const body: string = p.body || '';
      const html = /<\w+[^>]*>/.test(body) ? body : (marked.parse(body) as string);
      quill.clipboard.dangerouslyPasteHTML(html);
      setStatus($('save-status'), '');
    } catch (err: any) { setStatus($('save-status'), err.message, 'err'); }
  }

  $('new-post').addEventListener('click', () => openEditor(null));
  $('back-to-list').addEventListener('click', () => loadList());

  async function prepareImage(file: File) {
    if (!file || !file.size) return undefined;
    const bitmap = await createImageBitmap(file).catch(() => null);
    if (!bitmap) { const buf = await file.arrayBuffer(); return { name: file.name, type: file.type, data: btoa(String.fromCharCode(...new Uint8Array(buf))) }; }
    const max = 1800, scale = Math.min(1, max / Math.max(bitmap.width, bitmap.height));
    const canvas = document.createElement('canvas');
    canvas.width = Math.round(bitmap.width * scale); canvas.height = Math.round(bitmap.height * scale);
    canvas.getContext('2d')!.drawImage(bitmap, 0, 0, canvas.width, canvas.height);
    const type = file.type === 'image/png' ? 'image/png' : 'image/jpeg';
    return { name: file.name, type, data: canvas.toDataURL(type, 0.85).split(',')[1] };
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const fd = new FormData(form);
    const html = quill.getSemanticHTML();
    if (!fd.get('title') || !quill.getText().trim()) { setStatus($('save-status'), 'Title and article are required.', 'err'); return; }
    const btn = $('save-btn') as HTMLButtonElement; btn.disabled = true;
    setStatus($('save-status'), 'Preparing…');
    try {
      const image = await prepareImage(fd.get('image') as File);
      setStatus($('save-status'), editingSlug ? 'Saving…' : 'Publishing…');
      const data = await api('/api/publish', { method: 'POST', body: JSON.stringify({
        slug: editingSlug || undefined, title: fd.get('title'), date: fd.get('date'), tag: fd.get('tag'), excerpt: fd.get('excerpt'), author: fd.get('author'),
        html, image, existingImage, removeImage: fd.get('removeImage') === 'on',
      }) });
      setStatus($('save-status'), `${editingSlug ? 'Saved' : 'Published'}. It'll be live at <a href="${data.url}">${location.origin}${data.url}</a> in a minute or two once the site rebuilds.`, 'ok');
      editingSlug = data.slug;
      $('editor-heading').textContent = 'Edit post';
      $('delete-btn').hidden = false;
      btn.innerHTML = 'Save changes <span class="arrow">→</span>';
    } catch (err: any) { setStatus($('save-status'), err.message || 'Something went wrong.', 'err'); }
    finally { btn.disabled = false; }
  });

  $('delete-btn').addEventListener('click', async () => {
    if (!editingSlug) return;
    const title = (form.elements.namedItem('title') as HTMLInputElement).value;
    // Two-step confirm without a browser dialog
    const btn = $('delete-btn') as HTMLButtonElement;
    if (btn.dataset.armed !== '1') { btn.dataset.armed = '1'; btn.textContent = 'Click again to delete for real'; setTimeout(() => { btn.dataset.armed = ''; btn.textContent = 'Delete post'; }, 4000); return; }
    btn.disabled = true; setStatus($('save-status'), 'Deleting…');
    try {
      await api('/api/posts', { method: 'DELETE', body: JSON.stringify({ slug: editingSlug }) });
      setStatus($('save-status'), `Deleted "${title}". It disappears from the site after the next rebuild.`, 'ok');
      setTimeout(loadList, 1200);
    } catch (err: any) { setStatus($('save-status'), err.message, 'err'); }
    finally { btn.disabled = false; btn.dataset.armed = ''; btn.textContent = 'Delete post'; }
  });

  // ---- boot
  if (token) loadList(); else show('login');
</script>
