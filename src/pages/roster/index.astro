---
import Base from '../../layouts/Base.astro';
import PlayerCard from '../../components/PlayerCard.astro';
import { meta, roster, coaches } from '../../lib/mcla';

const groups: [string, string[]][] = [
  ['Attack', ['Attack']],
  ['Midfield', ['Midfield']],
  ['Faceoff', ['FOS', 'FOGO']],
  ['Defensive Midfield', ['SSDM', 'LSM']],
  ['Defense', ['Defense']],
  ['Goalie', ['Goalie']],
];
const grouped = groups
  .map(([label, positions]) => [label, roster.filter((p) => positions.includes(p.position || ''))] as const)
  .filter(([, list]) => list.length);
const other = roster.filter((p) => !groups.some(([, ps]) => ps.includes(p.position || '')));
if (other.length) grouped.push(['Roster', other]);
---
<Base title={`${meta.season} Roster`} description={`Meet the ${meta.season} Michigan State Men's Lacrosse roster and coaching staff.`}>
  <div class="container page">
    <div class="eyebrow">{meta.season} Roster</div>
    <h1 class="h-page">The Spartans</h1>
    <p class="muted" style="text-align:center;margin-top:20px">{roster.length} players · Tap a player for their season stats</p>

    <div class="filters" data-reveal>
      <button class="chip is-active" data-group="all" type="button">All</button>
      {grouped.map(([label]) => <button class="chip" data-group={label} type="button">{label}</button>)}
    </div>

    {grouped.map(([label, players]) => (
      <section class="group" data-group={label}>
        <h2 class="group-title">{label} <span class="dim">{players.length}</span></h2>
        <div class="grid-players">
          {players.map((p, i) => <PlayerCard player={p} delay={Math.min(i, 5) * 80} showHometown />)}
        </div>
      </section>
    ))}

    {coaches.length > 0 && (
      <section class="group" data-group="Coaches">
        <h2 class="group-title">Coaching Staff</h2>
        <div class="coaches">
          {coaches.map((c) => (
            <a class="card coach" href={c.url || '#'} target="_blank" rel="noopener">
              <div class="coach-photo">
                {c.headshot ? <img src={c.headshot} alt={`${c.name}`} loading="lazy" /> : <img class="fallback" src="/logo-white.png" alt="" />}
              </div>
              <div>
                <div class="coach-name">{c.name}</div>
                <div class="coach-title">{c.title}{c.hometown ? ` · ${c.hometown}` : ''}</div>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>
</Base>

<style>
  .page { padding-top: 180px; min-height: 100vh; }
  .filters { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; margin-top: 40px; }
  .chip { padding: 10px 18px; border-radius: 999px; border: 1px solid var(--border); background: var(--card); color: var(--muted); font-size: 14px; font-weight: 600; cursor: pointer; transition: all 0.2s; }
  .chip:hover { border-color: var(--border-hover); color: #fff; }
  .chip.is-active { background: var(--green); border-color: var(--green); color: #fff; }
  .group { margin-top: 64px; }
  .group[hidden] { display: none; }
  .group-title { font-size: clamp(24px, 2.6vw, 34px); margin-bottom: 24px; display: flex; align-items: baseline; gap: 12px; }
  .group-title .dim { font-size: 16px; font-weight: 600; }
  .coaches { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 20px; }
  .coach { display: flex; align-items: center; gap: 18px; padding: 16px; color: #fff; }
  .coach-photo { width: 72px; height: 86px; border-radius: 12px; overflow: hidden; background: #131313; flex: none; display: grid; place-items: center; }
  .coach-photo img { width: 100%; height: 100%; object-fit: cover; object-position: top; }
  .coach-photo img.fallback { width: 40%; height: auto; opacity: 0.35; }
  .coach-name { font-size: 20px; font-weight: 600; letter-spacing: -0.02em; }
  .coach-title { font-size: 14px; color: var(--muted); margin-top: 4px; }
</style>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>('.chip');
  const groups = document.querySelectorAll<HTMLElement>('.group');
  chips.forEach((c) => c.addEventListener('click', () => {
    chips.forEach((x) => x.classList.toggle('is-active', x === c));
    const g = c.dataset.group;
    groups.forEach((s) => { s.hidden = g !== 'all' && s.dataset.group !== g; });
    // Cards inside newly-shown groups may not have been revealed yet
    document.querySelectorAll<HTMLElement>('.group:not([hidden]) [data-reveal]').forEach((el) => el.classList.add('is-visible'));
  }));
</script>
