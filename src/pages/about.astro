---
import Base from '../layouts/Base.astro';
import PhotoTile from '../components/PhotoTile.astro';
import { site } from '../data/site';
import { meta, coaches } from '../lib/mcla';
---
<Base title="About" description={site.about.body[0]}>
  <div class="container page">
    <div class="eyebrow">About the team</div>
    <h1 class="h-page">Michigan State Men's Lacrosse</h1>
    <PhotoTile src={site.about.teamPhoto.src} alt={site.about.teamPhoto.alt} label="Team photo" class="team-photo" />
    <div class="prose" data-reveal>
      {site.about.body.map((p) => <p>{p}</p>)}
    </div>
    {coaches.length > 0 && (
      <div class="staff" data-reveal>
        <h2>Coaching Staff</h2>
        <ul>
          {coaches.map((c) => <li><b>{c.name}</b> <span class="muted">— {c.title}</span></li>)}
        </ul>
      </div>
    )}
    <div class="center" data-reveal style="margin-top:56px;gap:14px;flex-wrap:wrap">
      <a href="/roster" class="btn">{meta.season} roster <span class="arrow">→</span></a>
      <a href="#contact" class="btn" data-open-contact>Join the team <span class="arrow">→</span></a>
    </div>
  </div>
</Base>

<style>
  .page { padding-top: 180px; min-height: 100vh; max-width: 1100px; }
  .page :global(.team-photo) { aspect-ratio: 3 / 2; margin: 56px 0; border-radius: 24px; }
  @media (max-width: 640px) { .page :global(.team-photo) { aspect-ratio: 4 / 3; margin: 36px 0; border-radius: 16px; } }
  .staff { max-width: 760px; margin: 40px auto 0; }
  .staff h2 { font-size: 26px; margin-bottom: 16px; }
  .staff ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; font-size: 18px; }
</style>
